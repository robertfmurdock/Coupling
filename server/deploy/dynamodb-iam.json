{
  "role": {
    "statements": [
      {
        "Sid": "LegacyPersistence",
        "Effect": "Allow",
        "Action": [
          "dynamodb:CreateTable",
          "dynamodb:DescribeTable",
          "dynamodb:PutItem",
          "dynamodb:Query"
        ],
        "Resource": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}TRIBE"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}USER"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}PLAYER"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}PIN"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}PAIR_ASSIGNMENTS"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}CONTRIBUTION"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}BOOST"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}SECRET"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}SLACK"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}DISCORD"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}LIVE_CONNECTION"
          }
        ]
      },
      {
        "Sid": "LegacyDiscovery",
        "Effect": "Allow",
        "Action": [
          "dynamodb:Scan"
        ],
        "Resource": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}TRIBE"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}USER"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}PLAYER"
          }
        ]
      },
      {
        "Sid": "LegacyIndexes",
        "Effect": "Allow",
        "Action": [
          "dynamodb:Query"
        ],
        "Resource": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}USER/index/USER_EMAIL_INDEX"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}PLAYER/index/PlayerEmailIndex"
          }
        ]
      },
      {
        "Sid": "LegacyDeletion",
        "Effect": "Allow",
        "Action": [
          "dynamodb:DeleteItem"
        ],
        "Resource": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}CONTRIBUTION"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}DISCORD"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${self:provider.environment.DYNAMO_PREFIX}LIVE_CONNECTION"
          }
        ]
      },
      {
        "Sid": "TargetBootstrap",
        "Effect": "Allow",
        "Action": [
          "dynamodb:CreateTable",
          "dynamodb:DescribeTable"
        ],
        "Resource": [
          {
            "Fn::Sub": [
              "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${TargetPrefix}coupling-*",
              {
                "TargetPrefix": {
                  "Fn::If": [
                    "UnprefixedTargetTables",
                    "",
                    "${sls:stage}-"
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "Sid": "TargetCore",
        "Effect": "Allow",
        "Action": [
          "dynamodb:GetItem",
          "dynamodb:PutItem",
          "dynamodb:DeleteItem",
          "dynamodb:ConditionCheckItem"
        ],
        "Resource": [
          {
            "Fn::Sub": [
              "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${TargetPrefix}coupling-core",
              {
                "TargetPrefix": {
                  "Fn::If": [
                    "UnprefixedTargetTables",
                    "",
                    "${sls:stage}-"
                  ]
                }
              }
            ]
          },
          {
            "Fn::Sub": [
              "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${TargetPrefix}coupling-core-*",
              {
                "TargetPrefix": {
                  "Fn::If": [
                    "UnprefixedTargetTables",
                    "",
                    "${sls:stage}-"
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "Sid": "TargetHistory",
        "Effect": "Allow",
        "Action": [
          "dynamodb:PutItem",
          "dynamodb:Query"
        ],
        "Resource": [
          {
            "Fn::Sub": [
              "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${TargetPrefix}coupling-history",
              {
                "TargetPrefix": {
                  "Fn::If": [
                    "UnprefixedTargetTables",
                    "",
                    "${sls:stage}-"
                  ]
                }
              }
            ]
          },
          {
            "Fn::Sub": [
              "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${TargetPrefix}coupling-history-*",
              {
                "TargetPrefix": {
                  "Fn::If": [
                    "UnprefixedTargetTables",
                    "",
                    "${sls:stage}-"
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "Sid": "TargetTtl",
        "Effect": "Allow",
        "Action": [
          "dynamodb:DescribeTimeToLive",
          "dynamodb:UpdateTimeToLive"
        ],
        "Resource": [
          {
            "Fn::Sub": [
              "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${TargetPrefix}coupling-live-connections",
              {
                "TargetPrefix": {
                  "Fn::If": [
                    "UnprefixedTargetTables",
                    "",
                    "${sls:stage}-"
                  ]
                }
              }
            ]
          },
          {
            "Fn::Sub": [
              "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${TargetPrefix}coupling-live-connections-*",
              {
                "TargetPrefix": {
                  "Fn::If": [
                    "UnprefixedTargetTables",
                    "",
                    "${sls:stage}-"
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
